msgstr "Bu sayfayı görüntüleme yetkiniz yok."

msgid "(Post #%d — deleted)"
msgstr "(Yazı #%d — silindi)"

msgid "%s ago"
msgstr "%s önce"

msgid "in %s"
msgstr "%s içinde"

msgid "Search"
msgstr "Ara"

msgid "Links"
msgstr "Bağlantılar"

