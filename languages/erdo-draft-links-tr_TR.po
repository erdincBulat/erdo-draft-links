msgstr "Son kullanma:"

msgid "You are not allowed to manage Ghost Links for this post."
msgstr "Bu yazı için Gizli Bağlantıları yönetme yetkiniz yok."

msgid "Could not save the link. Please try again."
msgstr "Bağlantı kaydedilemedi. Lütfen tekrar deneyin."

msgid "Could not load Ghost Link data."
msgstr "Gizli Bağlantı verisi yüklenemedi."

msgid "Could not generate the link. Please try again."
msgstr "Bağlantı oluşturulamadı. Lütfen tekrar deneyin."

msgid "Could not revoke the link. Please try again."
msgstr "Bağlantı iptal edilemedi. Lütfen tekrar deneyin."

msgid "An error occurred. Please try again."
msgstr "Bir hata oluştu. Lütfen tekrar deneyin."

msgid "This link is invalid or has expired."
msgstr "Bu bağlantı geçersiz veya süresi dolmuş."

msgid "This Ghost Link has expired and is no longer accessible."
msgstr "Bu Gizli Bağlantının süresi dolmuş ve artık erişilemez."

msgid "This Ghost Link has been revoked."
msgstr "Bu Gizli Bağlantı iptal edilmiş."

