msgid "Ghost Link"
msgstr "Gizli Bağlantı"

msgid "Share draft posts with non-logged-in users via a secure, temporary link — no login required."
msgstr "Taslak yazıları giriş yapmayan kullanıcılarla güvenli, geçici bir bağlantı aracılığıyla paylaşın — giriş gerekmez."

msgid "Generate a secure link to share this draft with anyone — no login required."
msgstr "Bu taslağı herkesle paylaşmak için güvenli bir bağlantı oluşturun — giriş gerekmez."

msgid "Generate Ghost Link"
msgstr "Gizli Bağlantı Oluştur"

msgid "Link Expiry"
msgstr "Bağlantı Süresi"

msgid "24 Hours"
msgstr "24 Saat"

msgid "48 Hours"
msgstr "48 Saat"

msgid "7 Days"
msgstr "7 Gün"

msgid "No Expiry"
msgstr "Süresiz"

msgid "Copy"
msgstr "Kopyala"

msgid "Copied!"
msgstr "Kopyalandı!"

msgid "Open"
msgstr "Aç"

msgid "Regenerate"
msgstr "Yenile"

msgid "Revoke"
msgstr "İptal Et"

msgid "Expires: %s"
msgstr "Son kullanma: %s"

msgid "No expiry."
msgstr "Süresiz."

msgid "Views: %d"
msgstr "Görüntülenme: %d"

msgid "Views:"
msgstr "Görüntülenme:"

