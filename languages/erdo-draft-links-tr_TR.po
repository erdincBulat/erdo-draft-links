msgstr "Taslak önizlemesine yeni geri bildirim: %s"

msgid "%1$s left feedback on the draft preview of \"%2$s\":\n\n%3$s\n\nManage feedback: %4$s"
msgstr "%1$s, \"%2$s\" taslağının önizlemesine geri bildirim bıraktı:\n\n%3$s\n\nGeri bildirimleri yönet: %4$s"

msgid "Past Feedback"
msgstr "Geçmiş Geri Bildirimler"

msgid "In Progress"
msgstr "Devam Ediyor"

msgid "Completed"
msgstr "Tamamlandı"

msgid "Mark as Completed"
msgstr "Tamamlandı Olarak İşaretle"

msgid "Mark as In Progress"
msgstr "Devam Ediyor Olarak İşaretle"

msgid "Feedback status updated."
msgstr "Geri bildirim durumu güncellendi."

msgid "Close"
msgstr "Kapat"

msgid "Sending…"
msgstr "Gönderiliyor…"
